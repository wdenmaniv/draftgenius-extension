{
  "manifest_version": 3,
  "name": "DraftGenius",
  "version": "0.0.47",
  "description": "Watches your live ESPN, Yahoo, or Sleeper fantasy football draft and recommends who to pick or bid on, calibrated against real historical projection accuracy and injury data.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://fantasy.espn.com/*",
    "https://football.fantasysports.yahoo.com/*",
    "https://sleeper.com/*",
    "https://api.sleeper.app/*",
    "https://qeyxikwruuuhandvkvan.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "externally_connectable": {
    "matches": ["https://draftgenius.vercel.app/*", "http://localhost/*"]
  },
  "action": {
    "default_title": "Open DraftGenius",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*",
        "https://football.fantasysports.yahoo.com/draftclient/*"
      ],
      "js": ["src/capture-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*",
        "https://football.fantasysports.yahoo.com/draftclient/*",
        "https://sleeper.com/draft/*"
      ],
      "js": ["src/dom/espn.js", "src/dom/yahoo.js", "src/dom/sleeper.js", "src/relay-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
